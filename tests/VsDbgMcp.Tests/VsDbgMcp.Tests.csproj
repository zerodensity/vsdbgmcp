<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VsDbgMcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VsDbgMcp.Core\VsDbgMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\VsDbgMcp.Shim\VsDbgMcp.Shim.csproj" />
  </ItemGroup>

  <!-- Several tests measure something the whole process shares: bytes allocated on the
       garbage-collected heap, and the environment variables a store reads when it opens.
       Another class running at the same time moves those numbers, and the test then reports a
       regression that is only a stranger's allocation. One at a time costs a few seconds and
       makes the measurements mean what they say. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\VsDbgMcp.Host\DebugHost.Profiling.cs" Link="Host\DebugHost.Profiling.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\Profiler.cs" Link="Host\Profiler.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\ShimStaging.cs" Link="Host\ShimStaging.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\ShimProcesses.cs" Link="Host\ShimProcesses.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\Activity.cs" Link="Host\Activity.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\PipeServer.cs" Link="Host\PipeServer.cs" />
    <Compile Include="..\..\src\VsDbgMcp.Host\SecurePipe.cs" Link="Host\SecurePipe.cs" />
  </ItemGroup>

</Project>
